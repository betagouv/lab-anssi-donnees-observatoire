{
  "name": "lab-anssi-donnees-observatoire",
  "version": "1.0.0",
  "description": "Migrations de la base de données de l'observatoire du Lab ANSSI",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betagouv/lab-anssi-donnees-observatoire.git"
  },
  "packageManager": "pnpm@12.19.0",
  "scripts": {
    "migration-bdd": "tsx --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:latest",
    "migration-bdd:annule": "tsx --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:rollback",
    "migration-bdd:nouvelle": "tsx --env-file-if-exists=.env node_modules/knex/bin/cli.js migrate:make -x ts",
    "verifie-types": "tsc --noEmit",
    "formate": "prettier --write ."
  },
  "dependencies": {
    "knex": "^3.1.0",
    "pg": "^8.8.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0"
  }
}
